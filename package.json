{
  "name": "contractor-crm-suite",
  "version": "1.0.0",
  "description": "Contractor Pro CRM Suite — Customer management, field time tracking, review dispatch, and admin panel",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create contractor_db",
    "db:migrate": "wrangler d1 execute contractor_db --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute contractor_db --local --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
